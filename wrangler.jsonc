{
  // ───────────────────────────────────────────────────────────────────
  // Despliegue del tablero SIA en Cloudflare Workers (assets estáticos)
  //
  // El sitio no tiene build: son cuatro archivos (index.html, styles.css,
  // app.js, config.js) más sw.js, vendor/, assets/ y data/. Por eso
  // "Build command" va VACÍO en el panel y aquí solo se declara qué carpeta
  // se publica.
  //
  // "directory": "./" publica el repositorio tal cual. OJO: wrangler NO
  // excluye .git por su cuenta (la sube entera), así que la exclusión vive
  // en el archivo .assetsignore de la raíz. Los dos archivos van juntos.
  //
  // El Service Worker (sw.js) queda en la raíz, que es donde tiene que
  // estar: su ámbito es la carpeta desde la que se sirve, y moverlo lo
  // dejaría sin control sobre index.html.
  // ───────────────────────────────────────────────────────────────────
  "name": "categorias-de-proteccion-ambiental",
  "compatibility_date": "2026-09-12",

  // Apagados a propósito. Con dominio propio, las direcciones *.workers.dev
  // sobran y además duplicarían el sitio en una dirección que nadie debería
  // citar. Van explícitas porque, si se omiten, wrangler las enciende por
  // omisión en cada despliegue.
  "workers_dev": false,
  "preview_urls": false,

  "assets": {
    "directory": "./"
  }
}
